COCKROACH_USER=your_username
COCKROACH_PASSWORD=your_password
COCKROACH_DATABASE=your_database
COCKROACH_HOST=your_cluster.cockroachlabs.cloud
COCKROACH_PORT=26257
COCKROACH_CLUSTER=your_cluster
COCKROACH_CLUSTER_ID=your_cluster_id
COCKROACH_SSL_ROOT_CERT=path/to/root.crt
PGSSLROOTCERT=path/to/root.crt
DATABASE_URL=postgresql://your_username:your_password@your_cluster.cockroachlabs.cloud:26257/your_database?sslmode=verify-full

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
PORT=8787
